+function roomSearchHtml(r){
+  const s=r?.search;if(!s?.available)return'';
+  if(!s.searched)return `<div class="searchBox"><strong>UNDERSØK ROMMET</strong><p>SE NÆRMERE PÅ VEGGER, GULV, MØBLER ELLER DET BARNET ER NYSGJERRIG PÅ. APPEN RØPER IKKE OM DET FINNES ET FUNN HER.</p><button class="small" data-room-search-start="1">SE DEG RUNDT</button></div>`;
+  if(!s.item)return `<div class="searchBox"><strong>ROMMET ER UNDERSØKT</strong><p>DERE FINNER INGEN SKJULT TING Å TA MED HER. BESKRIV GJERNE ÉN LITEN DETALJ SOM GJØR ROMMET LEVENDE.</p></div>`;
+  if(s.taken)return `<div class="searchBox found"><strong>ROMMET ER UNDERSØKT</strong><p>DET DERE FANT HER ER ALLEREDE TATT MED.</p></div>`;
+  if(s.revealed){
+    const item=s.item||{},ref=item.entityId?A.entity(item.entityId,{label:item.name,visualKind:'item'}):A.entityForItemName(item.name),visual=ref?A.entityHtml(ref,{interactive:true,label:item.name,caption:item.findGuide||findGuide(item.name)}):'';
+    return `<div class="searchBox found"><strong>DU FANT NOE!</strong><div class="entityTextRow">${visual}<div><b>${item.name}</b><p>${item.intro||''}</p><p class="sub">${item.findGuide||findGuide(item.name)||'LA BARNET FORESLÅ HVA DET KAN BRUKES TIL.'}</p></div></div><button class="small primary" data-search-take="1">TA FUNNET</button></div>`;
+  }
+  const selected=s.lastDiceValue||'';
+  const dice=[1,2,3,4,5,6].map(v=>dieFaceButton(v,selected,'data-room-search-die="1"')).join('');
+  const lowHint=s.attempts>0?'<p><b>STERKERE HINT:</b> NOE I ROMMET SER UT SOM DET HAR BLITT FLYTTET ELLER GJEMT. BESKRIV ET KONKRET STED BARNET KAN UNDERSØKE NÆRMERE.</p>':'<p>NOE SER UT SOM DET KAN VÆRE GJEMT HER. HVIS DET ER USIKKERT OM HELTEN FINNER DET, KAST FYSISK D6.</p>';
+  return `<div class="searchBox"><strong>LET ETTER DET GJEMTE</strong>${lowHint}<p class="sub">DETTE ER ALLTID ET VALGFRITT FUNN, ALDRI EN STORY-NØKKEL.</p><div class="diceChoices">${dice}</div></div>`;
+}
+function beginRoomSearch(){
+  const r=currentRoom(),s=r?.search;if(!s?.available||s.searched)return;
+  s.searched=true;
+  if(s.item){addLog(`DERE UNDERSØKTE ${r.name}. NOE KAN VÆRE GJEMT HER.`);toast('NOE KAN VÆRE GJEMT HER ...');}
+  else{addLog(`DERE UNDERSØKTE ${r.name}.`);toast('DERE SER DERE RUNDT');}
+  save();renderRoom();renderScenario();
+}
+function registerRoomSearchDice(value){
+  const r=currentRoom(),s=r?.search;if(!s?.available||!s.searched||!s.item||s.taken||s.revealed)return;
+  const band=bandForDie(value);if(!validDiceBand(band))return;
+  s.attempts=Math.max(0,s.attempts||0)+1;s.lastDiceValue=Number(value);s.lastDiceBand=band;
+  if(band!=='low'||s.attempts>=2){
+    s.revealed=true;
+    addLog(`NOE BLE FUNNET VED Å LETE I ${r.name}: ${s.item?.name||'ET FUNN'}.`);
+    toast('DU FANT NOE!');
+  }else{
+    addLog(`DERE LETTE I ${r.name} OG FIKK ET STERKERE HINT.`);
+    toast('NOE ER GJEMT HER ...');
+  }
+  save();renderRoom();renderScenario();
+}
+function takeRoomSearchFind(){
+  const r=currentRoom(),s=r?.search;if(!s?.available||!s.revealed||s.taken)return;
+  const item=s.item?.name;if(!item)return;
+  if(state.inventory.length>=6){toast('RYGGSEKKEN ER FULL');return;}
+  state.inventory.push(item);s.taken=true;
+  addLog(`TOK MED ${item} FRA ${r.name}.`);save();render();toast('FUNNET ER I SEKKEN');
+}
+function bindRoomSearch(){
+  $$('[data-room-search-start]').forEach(b=>b.onclick=()=>beginRoomSearch());
+  $$('[data-room-search-die]').forEach(b=>b.onclick=()=>{const v=Number(b.dataset.dieValue);pulseDieButton(b,()=>registerRoomSearchDice(v))});
+  $$('[data-search-take]').forEach(b=>b.onclick=()=>takeRoomSearchFind());
+}
+function encounterProgressHtml(o){
+  if(!Number.isFinite(o?.progress)||!Number.isFinite(o?.maxProgress))return'';
+  const max=Math.max(1,o.maxProgress),n=Math.max(0,Math.min(max,o.progress));
+  return `<div class="encounterTrack"><b>ANNEN LØSNING · ${n}/${max}</b><div class="trackPips">${'◆'.repeat(n)}${'◇'.repeat(max-n)}</div><span>MARKER FREMGANG NÅR BARNETS PLAN FAKTISK ENDRER SITUASJONEN.</span></div>`;
+}

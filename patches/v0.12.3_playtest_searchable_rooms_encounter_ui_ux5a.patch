+function registerRoomSearchDice(value){
+  const r=currentRoom(),s=r?.search;if(!s?.available||s.taken||s.revealed)return;
+  const band=bandForDie(value);if(!validDiceBand(band))return;
+  s.searched=true;s.attempts=Math.max(0,s.attempts||0)+1;s.lastDiceValue=Number(value);s.lastDiceBand=band;
+  if(band!=='low'||s.attempts>=2){
+    s.revealed=true;
+    addLog(`NOE BLE FUNNET VED Å LETE I ${r.name}: ${s.item?.name||'ET FUNN'}.`);
+    toast('DU FANT NOE!');
+  }else{
+    addLog(`DERE LETTE I ${r.name} OG FIKK ET STERKERE HINT.`);
+    toast('NOE ER GJEMT HER ...');
+  }
+  save();renderRoom();renderScenario();
+}
+function takeRoomSearchFind(){
+  const r=currentRoom(),s=r?.search;if(!s?.available||!s.revealed||s.taken)return;
+  const item=s.item?.name;if(!item)return;
+  if(state.inventory.length>=6){toast('RYGGSEKKEN ER FULL');return;}
+  state.inventory.push(item);s.taken=true;
+  addLog(`TOK MED ${item} FRA ${r.name}.`);save();render();toast('FUNNET ER I SEKKEN');
+}
